#!/usr/bin/env bash
set -euo pipefail

timeout_seconds="${1:-60}"
poll_interval="${2:-2}"

# The polling loop is intentionally passed literally to the bounded child shell.
# shellcheck disable=SC2016
if timeout --foreground "$timeout_seconds" bash -c '
  until ghvmctl exec "gnome-screenshot -w -f /home/ubuntu/.ghvmctl-window-ready.png && test -s /home/ubuntu/.ghvmctl-window-ready.png" >/dev/null 2>&1; do
    sleep "$1"
  done
' _ "$poll_interval"; then
  echo "Application window is ready"
  exit 0
fi

echo "Timed out waiting for an application window after ${timeout_seconds}s" >&2
exit 1
